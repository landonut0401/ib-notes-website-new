/* Marginalia styles. Link it in your page's <head> with: <link rel="stylesheet" href="style.css"> */
/* Fonts used (add to <head>): Cormorant Garamond, DM Sans, Atkinson Hyperlegible from Google Fonts */
 
:root{--bg:#F3F2F6;--surface:#FFFFFF;--ink:#211B33;--muted:#6B6580;--line:#DAD6E4;--plum:#5B3A6B;--sage:#6F8F72;--brass:#A9833F;--tint:#E9E4F0;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#17131F;--surface:#221D2E;--ink:#EEEAF5;--muted:#A49DB8;--line:#3A3349;--plum:#B692CC;--sage:#93B596;--brass:#D2AE6C;--tint:#2D2640}}
:root[data-theme="dark"]{--bg:#17131F;--surface:#221D2E;--ink:#EEEAF5;--muted:#A49DB8;--line:#3A3349;--plum:#B692CC;--sage:#93B596;--brass:#D2AE6C;--tint:#2D2640}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font:400 16px/1.55 'DM Sans',system-ui,sans-serif}
h1,h2,h3{font-family:'Cormorant Garamond',Georgia,serif;font-weight:500;margin:0;line-height:1.05}
.wrap{max-width:1040px;margin:0 auto;padding:0 22px}
header.top{display:flex;justify-content:space-between;align-items:center;padding:22px 0}
.brand{font-family:'Cormorant Garamond',Georgia,serif;font-size:26px;font-weight:600;font-style:italic}
.top nav{display:flex;gap:22px;font-size:14px;color:var(--muted)}
.hero{padding:34px 0 26px}
.hero h1{font-size:clamp(42px,7.5vw,84px);max-width:11em;letter-spacing:-.01em}
.hero p{max-width:34em;color:var(--muted);font-size:17px;margin:18px 0 0}
.grades{margin-top:34px}
.grades small{display:block;color:var(--muted);font-size:13px;margin-bottom:8px}
.ruler{display:flex;border-bottom:2px solid var(--ink);overflow-x:auto;gap:0}
.ruler button{flex:1 0 auto;min-width:64px;background:none;border:0;border-left:1px solid var(--line);padding:6px 14px 10px;cursor:pointer;color:var(--muted);font-family:'Cormorant Garamond',Georgia,serif;font-size:clamp(34px,6vw,60px);font-weight:500;line-height:1;position:relative;text-align:left}
.ruler button:first-child{border-left:0}
.ruler button span{display:block;font:500 11px 'DM Sans',sans-serif;margin-top:4px;color:var(--muted)}
.ruler button[aria-pressed=true]{color:var(--ink)}
.ruler button[aria-pressed=true]::after{content:"";position:absolute;left:0;right:0;bottom:-2px;height:6px;background:var(--brass)}
.ruler button:hover{color:var(--plum)}
:focus-visible{outline:2px solid var(--plum);outline-offset:2px}
.bar{display:flex;flex-wrap:wrap;gap:14px;align-items:center;justify-content:space-between;margin:26px 0 8px}
.bar .info{font-size:15px;color:var(--muted)}
.bar .info b{color:var(--ink);font-weight:600}
.tools{display:flex;gap:12px;flex-wrap:wrap;align-items:center}
.seg{display:inline-flex;border:1px solid var(--line);border-radius:999px;background:var(--surface);padding:3px}
.seg button{border:0;background:none;color:var(--muted);padding:6px 16px;border-radius:999px;font:500 14px 'DM Sans',sans-serif;cursor:pointer}
.seg button[aria-pressed=true]{background:var(--ink);color:var(--bg)}
.search{border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:999px;padding:9px 18px;font:400 14px 'DM Sans',sans-serif;min-width:220px}
.group{margin-top:34px}
.group h2{font-size:30px;padding-bottom:8px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:baseline;gap:12px}
.group h2 em{font:400 13px 'DM Sans',sans-serif;color:var(--muted);font-style:normal}
.shelf{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:14px;margin-top:16px}
.book{all:unset;box-sizing:border-box;cursor:pointer;display:flex;background:var(--surface);border:1px solid var(--line);border-radius:4px 10px 10px 4px;min-height:104px;overflow:hidden;transition:transform .18s,border-color .18s}
.book:hover{transform:translateY(-3px);border-color:var(--plum)}
.book:focus-visible{outline:2px solid var(--plum);outline-offset:2px}
.spine{width:16px;flex:none;background:var(--c);box-shadow:inset -3px 0 0 rgba(0,0,0,.12)}
.bk{padding:14px 16px;display:flex;flex-direction:column;justify-content:space-between;gap:10px;flex:1}
.bk h3{font-size:24px}
.bk .meta{font-size:13px;color:var(--muted);display:flex;gap:6px;flex-wrap:wrap}
.tag{border:1px solid var(--line);border-radius:999px;padding:1px 9px;font-size:12px;color:var(--muted)}
.tag.hl{background:var(--tint);color:var(--plum);border-color:transparent;font-weight:600}
.empty{color:var(--muted);padding:30px 0}
footer{margin:70px 0 40px;padding-top:20px;border-top:1px solid var(--line);color:var(--muted);font-size:13px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px}
/* panel */
.scrim{position:fixed;inset:0;background:rgba(20,14,30,.5);opacity:0;pointer-events:none;transition:opacity .2s;z-index:10}
.scrim.on{opacity:1;pointer-events:auto}
.panel{position:fixed;top:0;right:0;bottom:0;width:min(560px,100%);background:var(--bg);z-index:11;transform:translateX(102%);transition:transform .25s ease;overflow-y:auto;padding:calc(26px + env(safe-area-inset-top,0px)) 26px calc(30px + env(safe-area-inset-bottom,0px));border-left:1px solid var(--line)}
.panel{visibility:hidden;transition:transform .25s ease,visibility 0s .25s}.panel.on{transform:none;visibility:visible;transition:transform .25s ease}.skip{position:absolute;left:-999px;top:8px}.skip:focus{left:12px;z-index:30;background:var(--ink);color:var(--bg);padding:9px 16px;border-radius:6px}
.panel .x{float:right;border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:999px;padding:6px 14px;cursor:pointer;font:500 13px 'DM Sans',sans-serif}
.panel h2{font-size:46px;margin-top:10px}
.panel .sub{color:var(--muted);margin:8px 0 18px;font-size:15px}
.topic{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:14px 16px;margin-top:10px}
.topic .t{display:flex;justify-content:space-between;gap:10px;align-items:baseline}
.topic h3{font-size:22px;line-height:1.15}
.dl{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.dl button{border:1px solid var(--line);background:var(--bg);color:var(--ink);border-radius:6px;padding:6px 12px;font:500 13px 'DM Sans',sans-serif;cursor:pointer}
.dl button:hover{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translate(-50%,20px);background:var(--ink);color:var(--bg);padding:11px 20px;border-radius:999px;font-size:14px;opacity:0;pointer-events:none;transition:.2s;z-index:20;max-width:92vw;text-align:center}
.toast.on{opacity:1;transform:translate(-50%,0)}
@media (max-width:560px){.top nav{gap:10px}.search{min-width:0;width:100%}}
.nl{background:none;border:0;border-bottom:2px solid transparent;color:var(--muted);font:500 14px 'DM Sans',sans-serif;cursor:pointer;padding:4px 0}.nl[aria-pressed=true]{color:var(--ink);border-color:var(--brass)}.nl.pill{border:1px solid var(--ink);border-radius:999px;padding:5px 14px;color:var(--ink)}
body.read{font:400 18px/1.75 'Atkinson Hyperlegible',sans-serif}body.read h1,body.read h2,body.read h3,body.read .brand,body.read .ruler button{font-family:'Atkinson Hyperlegible',sans-serif;font-weight:700}
input,select,button{font-family:inherit}
.card{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:18px}.card h3{font-size:26px;margin-bottom:10px}.narrow{max-width:460px;margin:24px auto}.narrow h2{font-size:42px}
.two{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px;margin-top:20px}
.stat span{font-size:13px;color:var(--muted);display:block}.stat b{font:500 38px 'Cormorant Garamond',Georgia,serif;display:block;line-height:1.1;margin:4px 0}.stat small{font-size:12px;color:var(--muted)}
.dh{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;padding-top:20px}.dh h2{font-size:52px}.ch{display:flex;justify-content:space-between;gap:10px;align-items:center}.ch select{width:auto}
.form label{display:block;font-size:13px;color:var(--muted);margin-top:10px}.form input,.form select,.card select,.card input{width:100%;border:1px solid var(--line);background:var(--bg);color:var(--ink);border-radius:6px;padding:9px 11px;font-size:15px;margin-top:4px}
.row{display:flex;gap:10px;margin-top:6px}.row>*{flex:1;min-width:0}
.pri{background:var(--ink);color:var(--bg);border:0;border-radius:999px;padding:10px 22px;font-weight:600;font-size:14px;cursor:pointer;margin-top:14px}.ghost{background:none;border:1px solid var(--line);color:var(--ink);border-radius:999px;padding:8px 18px;font-size:14px;cursor:pointer;margin-top:10px}
.none{color:var(--muted);font-size:14px;margin:6px 0}.uni{display:flex;justify-content:space-between;gap:10px;padding:8px 0;border-bottom:1px solid var(--line)}.uni small{display:block;color:var(--muted)}.pb{height:6px;background:var(--tint);border-radius:9px;margin-top:6px;width:180px;max-width:100%}.pb i{display:block;height:100%;background:var(--sage);border-radius:9px}
.rm{background:none;border:0;color:var(--muted);cursor:pointer;font-size:18px}.opt{display:block;width:100%;text-align:left;margin-top:8px;padding:10px 12px;border:1px solid var(--line);background:var(--bg);color:var(--ink);border-radius:6px;font-size:15px;cursor:pointer}.opt:disabled{cursor:default}.opt.ok{border-color:var(--sage);background:var(--tint)}.opt.bad{border-color:#B5485A}.qq{font-weight:600;margin:14px 0 0}
.nt{color:var(--plum);font-size:14px;font-weight:600;text-decoration:underline}.add{border-style:dashed!important}.stim{border-left:3px solid var(--brass);background:var(--tint);padding:10px 14px;margin:10px 0;font-size:14px;white-space:pre-wrap}#qa h4{margin:12px 0 2px;font:600 14px 'DM Sans',sans-serif}#qa ul{padding-left:18px;margin:4px 0}#qa textarea{width:100%;border:1px solid var(--line);background:var(--bg);color:var(--ink);border-radius:6px;padding:10px;font-size:15px;line-height:1.5;font-family:inherit;margin-top:8px}
.uni>div:first-child{flex:1}.uni button.ghost{margin:0 6px 0 0;padding:4px 12px;align-self:flex-start}#pdlg{width:min(640px,94vw);max-height:88vh}#pdlg h3{font-size:32px}.chips{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0}.chip{border:1px solid var(--line);border-radius:8px;padding:8px 12px;font-size:13px;color:var(--muted)}.chip b{display:block;color:var(--ink);font-size:15px}#pbody ul{padding-left:18px;margin:6px 0}#pbody h4{margin:16px 0 4px;font:600 14px 'DM Sans',sans-serif}#af{margin-top:6px}.seg button{cursor:pointer}
#tm{font:500 44px 'Cormorant Garamond',serif;margin-right:12px}dialog{border:1px solid var(--line);border-radius:10px;background:var(--surface);color:var(--ink);width:min(420px,92vw)}
@media (max-width:760px){.two{grid-template-columns:1fr}.dh h2{font-size:38px}}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
 
