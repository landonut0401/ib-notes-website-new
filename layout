    <form id="gf" class="form"><label>Your name<input id="gn" required></label><label>Your grade<select id="gg"></select></label><label>Target IB points (out of 45)<input id="gp" type="number" min="1" max="45" value="36"></label><label>Dream university<input id="gu" placeholder="e.g. University of Toronto"></label><button class="pri" type="submit">Save profile</button></form></div>
