    <form id="af" class="form"><label id="anl" hidden>Your name<input id="an" autocomplete="name"></label><label>Email<input id="ae" type="email" required autocomplete="email"></label><label>Password<input id="ap" type="password" minlength="8" required autocomplete="current-password"></label><p class="none" id="aerr" role="alert"></p><button class="pri" type="submit" id="asub">Log in</button></form><p class="none">Free for every student. Your account and scores are saved in this browser on this device.</p></div>
