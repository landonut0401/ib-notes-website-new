if(!Array.isArray(qs)||!qs.length)throw 0;const w=kind!=="mcq";QZ={sub,top,qs,i:0,s:0,done:false,mode:w?"w":"m",kind:{mcq:"Paper 1 style",st:"Paper 2 style",ex:"Extended response"}[kind],max:w?qs.reduce((a,q)=>a+(+q.marks||0),0):0};showQ()}catch(e){out.innerHTML='<p class="none">Could not set a paper right now. Try again in a moment.</p>'}}
function showW(){const z=QZ,q=z.qs[z.i];$("#qa").innerHTML=`<p class="none">${esc(z.kind)}, question ${z.i+1} of ${z.qs.length}</p>${q.stimulus?`<div class="stim">${esc(q.stimulus)}</div>`:""}<p class="qq">${esc(q.question)} <b>[${+q.marks||0} marks]</b></p><textarea id="wa" rows="7" aria-label="Your answer" placeholder="Write your answer as you would in the exam"></textarea><button class="pri" id="wm">Mark my answer</button><div id="wr"></div>`}
async function markW(){const z=QZ,q=z.qs[z.i],a=$("#wa").value.trim(),r=$("#wr");if(a.length<5){toast("Write an answer first");return}r.innerHTML='<p class="none">Marking…</p>';$("#wm").disabled=true;
try{const m=await SMP.json(`You are a strict but fair IB examiner. Mark this answer out of ${q.marks} using the mark scheme.\nQuestion: ${q.question}\nStimulus: ${q.stimulus||"none"}\nMark scheme: ${[].concat(q.scheme||[]).join(" | ")}\nStudent answer: ${a}\nReturn ONLY JSON: {"awarded":integer from 0 to ${q.marks},"went_well":[strings],"to_improve":[strings tied to the mark scheme and the command term],"full_marks_answer":a concise model answer}.`,{cache:false});
const aw=Math.max(0,Math.min(+q.marks||0,Math.round(+m.awarded||0)));z.s+=aw;$("#wa").disabled=true;
r.innerHTML=`<p class="qq">${aw} / ${q.marks} marks</p><h4>What went well</h4>${ul(m.went_well)}<h4>To improve</h4>${ul(m.to_improve)}<h4>Model answer</h4><p>${esc(m.full_marks_answer||"")}</p><button class="ghost" data-next>${z.i===z.qs.length-1?"See result":"Next question"}</button>`}catch(e){$("#wm").disabled=false;r.innerHTML='<p class="none">Could not mark that right now. Try again.</p>'}}
document.addEventListener("click",e=>{if(e.target.id==="wm")markW()});

$("#qs").addEventListener("change",()=>P&&fillTopics());
document.addEventListener("click",async e=>{const t=e.target,id=t.id;
const nv=t.closest("[data-v]");if(nv){showView(nv.dataset.v);return}
if(id==="acct"){showView("dash");return}
if(id==="theme"){const on=document.body.classList.toggle("read");try{localStorage.setItem("marginalia:read",on?"1":"0")}catch(x){}t.setAttribute("aria-pressed",on);return}
if(id==="edit"){showGate();return}
if(id==="lb"){const v=parseFloat($("#lv").value),m=parseFloat($("#lm").value)||100;if(isNaN(v)||v<0||v>m){toast("Enter a score between 0 and the maximum");return}P.scores.push({sub:$("#ls").value,pct:Math.round(v/m*1000)/10,d:$("#ld").value||today(),k:$("#lk").value});touch();await saveP();$("#lv").value="";refresh();updAcct();toast("Score added");return}
if(id==="ua"){const n=$("#un").value.trim();if(!n){toast("Type a university name first");return}P.unis.push({n,c:$("#uc").value.trim(),p:+$("#up").value||0});$("#un").value=$("#uc").value=$("#up").value="";await saveP();unis();return}
const ru=t.closest("[data-ru]");if(ru){P.unis.splice(+ru.dataset.ru,1);await saveP();unis();return}
if(id==="qb"){startPaper();return}
if(id==="qsave"){P.scores.push({sub:QZ.sub,pct:Math.round(QZ.s/(QZ.max||QZ.qs.length)*100),d:today(),k:QZ.kind||"Quiz"});touch();await saveP();refresh();toast("Quiz score saved");return}
const o=t.closest("[data-o]");if(o&&QZ&&!QZ.done){QZ.done=true;const q=QZ.qs[QZ.i],j=+o.dataset.o;$$("#qa .opt").forEach((b,k)=>{b.disabled=true;if(k===q.answer)b.classList.add("ok");else if(k===j)b.classList.add("bad")});if(j===q.answer)QZ.s++;$("#fb").innerHTML=(j===q.answer?"Correct. ":"Not quite. ")+esc(q.why||"")+' <button class="ghost" data-next>'+(QZ.i===QZ.qs.length-1?"See result":"Next")+"</button>";return}
if(t.closest("[data-next]")){QZ.i++;QZ.done=false;showQ();return}
if(id==="ts"){if(tmI){clearInterval(tmI);tmI=null;t.textContent="Start"}else{t.textContent="Pause";tmI=setInterval(()=>{if(--tmS<=0){clearInterval(tmI);tmI=null;tmS=1500;$("#ts").textContent="Start";toast("Focus session done. Take a 5 minute break.")}tmShow()},1000)}return}
if(id==="tr"){clearInterval(tmI);tmI=null;tmS=1500;$("#ts").textContent="Start";tmShow();return}
});
$("#q").addEventListener("input",e=>{query=e.target.value.trim();renderShelves()});
renderRuler();renderShelves();
</script>
</body>
</html>
